# MistakeMap works without any key (demo mode: bundled sample analyses + an offline heuristic).
# Add ONE of the keys below to switch on live AI analysis.

# Option A: Claude (Anthropic API, https://console.anthropic.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Option B: Gemini (Google AI Studio, free tier, https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Force a provider when both keys are set: anthropic | gemini | demo
# AI_PROVIDER=

# Optional limits for a public deployment
# MAX_ANSWERS=60
# RATE_LIMIT_PER_HOUR=12
